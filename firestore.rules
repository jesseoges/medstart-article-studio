rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null 
          && request.auth.uid == "PASTE_YOUR_CORRECT_UID_HERE";
    }

    match /articles/{articleId} {
      allow read: if isAdmin() || (resource != null && resource.data.published == true);
      allow create: if isAdmin() && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
