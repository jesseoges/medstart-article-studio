rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace the placeholder with the administrator UID from Firebase Authentication.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "smtj86b2YSgSfWEGPZNNmUVdioji";
    }
    match /articles/{articleId} {
      // Anyone may read published articles only; drafts are private.
      allow get, list: if (resource.data.published == true || isAdmin());
      allow create: if isAdmin() && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    // No client access to other collections unless separately and deliberately configured.
  }
}
