rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Article images must be readable by visitors, but uploads are admin-only.
    match /article-images/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == "smtj86b2YSgSfWEGPZNNmUVdioji"
        && userId == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.uid == "smtj86b2YSgSfWEGPZNNmUVdioji"
        && userId == request.auth.uid;
    }
  }
}